# Milestone 11 Part 5. Template for a self-hosted Docker Compose
# deployment (compose.prod.yaml) — NOT for local development (see
# .env.example / compose.yaml for that instead).
#
# 1. Copy this file:  cp .env.production.example .env.production
# 2. Replace every REPLACE_ME placeholder below with your own strong,
#    unique values. Never reuse a value from .env.example or
#    compose.yaml (those are throwaway development credentials, and are
#    the same for every checkout of this repository).
# 3. .env.production is gitignored — it is never committed.
#
# IMPORTANT — DATABASE_URL and the POSTGRES_* variables below must
# describe the exact same database. They are supplied separately, on
# purpose: constructing DATABASE_URL automatically from POSTGRES_PASSWORD
# would be fragile the moment that password contains a character (@, :,
# /, %, ...) that needs URL-encoding, silently producing a broken or
# misinterpreted connection string. Nothing checks this consistency for
# you — if you change one, change the other to match.

# --- PostgreSQL (read by the postgres container only once, the first
#     time its data volume is initialized) ---
POSTGRES_DB=go_invoicing
POSTGRES_USER=go_invoicing
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_UNIQUE_PASSWORD

# --- Go Invoicing (read by the app container on every start) ---
# "postgres" is compose.prod.yaml's service name, resolved via Docker's
# own internal DNS — leave it as the literal word "postgres", not a real
# hostname. Only the user/password/dbname portions need to match the
# POSTGRES_* values above.
DATABASE_URL=postgres://go_invoicing:REPLACE_ME_WITH_A_STRONG_UNIQUE_PASSWORD@postgres:5432/go_invoicing?sslmode=disable

# --- Image build metadata (optional — see README's "Release builds"
#     section). Leave as-is for a local/evaluation build; a real release
#     would set these to match a specific cmd/release-built version. ---
VERSION=dev
COMMIT=unknown
BUILD_TIME=unknown

.env
# Milestone 11 Part 5: the real, credential-bearing self-hosted Compose
# env file — .env.production.example is the checked-in, placeholder-only
# template.
.env.production

# macOS
.DS_Store

# Windows
Thumbs.db

# Go
*.test
coverage.out

# Release build output (Milestone 11 Part 4) — cmd/release writes
# artifacts/checksums here; never committed.
/dist/

# IDEs
.vscode/
.idea/

# Frontend production build output (Milestone 12) — internal/webui embeds
# this directory via go:embed; `cd web && npm run build` writes here
# directly (see web/vite.config.ts's build.outDir). Only the committed
# placeholder index.html stays tracked, so `go build ./...`/`go test
# ./...` never require Node — see internal/webui/webui.go and the
# README's frontend section. Never commit a real build's output here.
/internal/webui/dist/*
!/internal/webui/dist/index.html

# Frontend toolchain (Milestone 12) — see web/.gitignore for the rest of
# the frontend-specific ignores (node_modules, coverage, Playwright
# output, etc.); these two matter at the repo root because a lockfile
# integrity/build check can be run from either location.
/web/node_modules/
/web/dist/
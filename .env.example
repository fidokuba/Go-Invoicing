# APP_ENV controls one safety rule (Milestone 11 Part 2): only
# APP_ENV=development may fall back to the DATABASE_URL default below.
# Any other value (production, staging, or anything else) REQUIRES
# DATABASE_URL to be set explicitly — see internal/config's own doc
# comment on resolveDatabaseURL.
APP_ENV=development

# APP_HOST is the interface to bind — empty (the default) binds every
# interface, exactly as this application always has. Set to 127.0.0.1 to
# bind loopback-only, or an IPv6 address such as ::1.
APP_HOST=
APP_PORT=8080

# DATABASE_URL below is a local, throwaway development credential pair —
# the same database compose.yaml provisions for local development. It is
# NOT suitable for any non-development deployment: copying it into a
# production environment would mean every deployment shares the same
# well-known password. A real deployment must set its own DATABASE_URL.
DATABASE_URL=postgres://go_invoicing:go_invoicing_dev@localhost:5432/go_invoicing?sslmode=disable

# LOG_FORMAT: "text" (development-friendly, the default) or "json"
# (structured, for a production log aggregator).
LOG_FORMAT=text
# LOG_LEVEL: "debug", "info" (the default), "warn", or "error".
LOG_LEVEL=info

# Session cleanup background worker (Milestone 6)
WORKER_ENABLED=true
WORKER_INTERVAL=1h
WORKER_BATCH_SIZE=500

# Prometheus /metrics endpoint (Milestone 10 Part 4). See README's
# Operations section for why this defaults to enabled.
METRICS_ENABLED=true
